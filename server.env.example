# Pi A2A Server — Environment Configuration
A2A_HOST=0.0.0.0
A2A_PORT=8002
A2A_URL=http://YOUR_SERVER_IP:8002
A2A_NAME=YourAgentName
A2A_TOKEN=your_64_char_hex_token_here

# ── Model configuration ──
# CHEAP tier: used for simple/status messages (no tools, fast + cheap)
A2A_MODEL=google/gemma-3-12b-it

# CAPABLE tier: used for complex coding/deployment tasks (full tools)
A2A_CAPABLE_MODEL=deepseek/deepseek-v4-pro

# ── Fallback chains: auto-switch when model returns credit/quota errors ──
# When the primary model hits a 402/429/503 (out of credit, rate limited),
# the server auto-restarts the pi process with the next model in the chain.
# Chains are comma-separated provider/model_id entries, tried in order.

# Fallback for CHEAP tier: Gemma → Qwen 3.6 Flash (Alibaba Plan)
A2A_CHEAP_FALLBACKS=alibaba-plan/qwen3.6-flash

# Fallback for CAPABLE tier: DeepSeek V4 Pro → Alibaba DS V4 Pro → Qwen 3.7 Max
A2A_CAPABLE_FALLBACKS=alibaba-plan/deepseek-v4-pro,alibaba-plan/qwen3.7-max

# Shared system prompt for fallback models (overridable per-model)
A2A_FALLBACK_SYSTEM_PROMPT=You are Pisti, a pi coding agent. Answer helpfully and concisely.

# Alibaba Model Studio Coding Plan token (for fallback models)
QWEN_API_KEY=sk-sp-your_alibaba_plan_token_here
