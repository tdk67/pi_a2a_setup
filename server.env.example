# Pi A2A Server — Environment Configuration
A2A_HOST=0.0.0.0
A2A_PORT=8002
A2A_URL=http://YOUR_SERVER_IP:8002
A2A_NAME=YourAgentName
A2A_TOKEN=your_64_char_hex_token_here

# ── Model configuration ──
# CHEAP tier: simple/status messages (no tools, fast + cheap)
# Primary: Alibaba Qwen 3.6 Flash — fast, cheap, good for simple tasks
A2A_MODEL=alibaba/qwen3.6-flash

# CAPABLE tier: complex coding/deployment tasks (full tools)
# Primary: DeepSeek V4 Pro — strong reasoning for complex tasks
A2A_CAPABLE_MODEL=deepseek/deepseek-v4-pro

# ── Fallback chains: auto-switch when model returns credit/quota errors ──
# When the primary model hits a 402/429/503 (out of credit, rate limited),
# the server auto-restarts the pi process with the next model in the chain.
# Chains are comma-separated provider/model_id entries, tried in order.
#
# Priority order:
#   1st — Provider-native models (Alibaba, DeepSeek) — best performance/price
#   2nd — Mid-tier capable models (Qwen 3.7 Pro/Max) — heavy reasoning
#   3rd — OpenRouter aggregators (last resort, broader availability)

# Fallback for CHEAP tier: Qwen 3.6 Flash → Qwen 3.7 Pro → Qwen 3.7 Max → DeepSeek V4 Flash (OpenRouter)
A2A_CHEAP_FALLBACKS=alibaba/qwen3.7-pro,alibaba/qwen3.7-max,openrouter/deepseek/deepseek-v4-flash

# Fallback for CAPABLE tier: DeepSeek V4 Pro → Qwen 3.7 Pro → Qwen 3.7 Max → DeepSeek V4 Pro (OpenRouter)
A2A_CAPABLE_FALLBACKS=alibaba/qwen3.7-pro,alibaba/qwen3.7-max,openrouter/deepseek/deepseek-v4-pro

# Shared system prompt for fallback models (overridable per-model)
A2A_FALLBACK_SYSTEM_PROMPT=You are Pisti, a pi coding agent. Answer helpfully and concisely.

# API Keys
# Alibaba Model Studio Coding Plan token (for alibaba/* models)
QWEN_API_KEY=sk-your-alibaba-api-key-here
# Anthropic API key (for anthropic/* models — optional)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# OpenRouter API key — last-resort fallback when above providers exhaust credit
OPENROUTER_API_KEY=sk-or-your-api-key-here
