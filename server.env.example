# Pi A2A Server — Environment Configuration
# Copy this to .env and fill in your agent's identity

A2A_HOST=0.0.0.0
A2A_PORT=8002
A2A_URL=http://YOUR_SERVER_IP:8002
A2A_NAME=YourAgentName
A2A_TOKEN=your_64_char_hex_token_here

# Model configuration
# Cheap model for simple chat/coordination (no tools, low cost)
A2A_MODEL=google/gemma-3-12b-it

# Capable model for real work (full tools, higher cost)
A2A_CAPABLE_MODEL=deepseek/deepseek-v4-pro

# System prompts (optional — defaults are fine)
# A2A_SYSTEM_PROMPT=You are an agent in a mesh. Answer concisely.
# A2A_CAPABLE_SYSTEM_PROMPT=You are a coding agent with full tools. Solve problems thoroughly.